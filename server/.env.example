# Dictate API server configuration
DICTATE_API_KEY=
DICTATE_HOST=0.0.0.0
DICTATE_PORT=8765

# ===========================================================================
# Whisper — the transcription speed knobs.
#
# Pick ONE of the presets below (copy its values over the block that follows).
#
# --- CPU-only server (no GPU) ---------------------------------------------
#   DICTATE_WHISPER_MODEL=small          # small.en is auto-selected for English
#   DICTATE_WHISPER_DEVICE=cpu
#   DICTATE_WHISPER_COMPUTE_TYPE=int8
#   DICTATE_WHISPER_BATCH_SIZE=8         # parallel VAD chunks -> 3-5x faster
#   DICTATE_WHISPER_BEAM_SIZE=1          # greedy decode, ~2x faster than 5
#
# --- GPU server (NVIDIA + CUDA) -------------------------------------------
#   DICTATE_WHISPER_MODEL=large-v3-turbo # top accuracy, still very fast on GPU
#   DICTATE_WHISPER_DEVICE=cuda
#   DICTATE_WHISPER_COMPUTE_TYPE=float16
#   DICTATE_WHISPER_BATCH_SIZE=16
#   DICTATE_WHISPER_BEAM_SIZE=1
# ===========================================================================
DICTATE_WHISPER_MODEL=small
DICTATE_WHISPER_DEVICE=cpu
DICTATE_WHISPER_COMPUTE_TYPE=int8
DICTATE_WHISPER_LANGUAGE=en

# Speed knobs (see presets above). BATCH_SIZE>1 needs faster-whisper>=1.1.0.
DICTATE_WHISPER_BEAM_SIZE=1
DICTATE_WHISPER_BATCH_SIZE=8
DICTATE_WHISPER_CPU_THREADS=0          # 0 = use all physical cores

# Upload limits and temp storage
DICTATE_MAX_UPLOAD_MB=50
DICTATE_TEMP_UPLOAD_DIR=/tmp/dictate-api-uploads

# Cleanup: basic (local rules, instant) or openai (LLM polish, adds a few sec).
DICTATE_CLEANUP_MODE=openai
OPENAI_API_KEY=
OPENAI_CLEANUP_MODEL=gpt-5.4-mini
OPENAI_CLEANUP_TIMEOUT=20
DICTATE_OPENAI_MAX_TOKENS=0            # 0 = no cap; e.g. 600 to bound long runs
